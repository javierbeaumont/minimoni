# User-facing binaries (built at repo root for distribution)
minimoni
minimoni-linux-*
minimoni-migrate
minimoni-migrate-linux-*

# Generated build outputs: everything `make` and `make debug` emit
# (embed.h, minimoni-debug) goes into build/.
build/

# CI release staging dir (the release job assembles the release assets here).
dist/

# Vendored library build tree (BearSSL sub-make's output)
vendor/bearssl/build/

# Local dev scratchpad: test DBs, preview configs, anything ephemeral.
# Convention: anything not for distribution and not a build artefact lives here.
.dev/

# Default DB created if the daemon runs from the repo root (config default: ./metrics.db)
metrics.db
metrics.db-wal
metrics.db-shm
